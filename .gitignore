# ============================================================
# DermAssist - Git Ignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
env/
.venv/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Data & Models (large files) ---
data/raw/*
data/processed/*
data/test/*
data/results/*
data/*_Backup/
data/
models/checkpoints/*
models/*backup*/
models/*swapped*/
models/production/*swapped*/
models/production/*.tmp
!models/
!models/production/
!models/production/*.pth
!**/.gitkeep

# --- Training Artifacts ---
training_history.png
*.log
scratch/

# --- OS ---
.DS_Store
Thumbs.db

# --- AI Assistant Configs ---
.agents/
AGENTS.md
GEMINI.md
